# 城治学生会物资管理系统 - 环境变量配置模板
# 复制本文件为 .env，然后修改下面的值

# JWT 加密密钥（生产环境务必修改为随机字符串）
SECRET_KEY=please-change-this-to-a-random-string

# 数据库文件路径
DATABASE_FILE=data/material.db

# 图片上传目录
UPLOAD_DIR=static/uploads

# 允许跨域的网址，多个用逗号分隔，* 表示全部允许（开发用）
# 生产环境建议改成你的域名，例如：https://your-domain.com
CORS_ORIGINS=*

# ====== 邮箱SMTP配置（忘记密码功能需要，不配置则该功能不可用）======
# QQ邮箱示例：
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的QQ邮箱@qq.com
# SMTP_PASSWORD=QQ邮箱授权码（不是登录密码）

# 163邮箱示例：
# SMTP_SERVER=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=你的邮箱@163.com
# SMTP_PASSWORD=授权码

SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
